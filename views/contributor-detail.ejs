<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('brand') %> - <%= contributor.full_name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1a237e">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/icons/icon-180.png">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&family=Montserrat:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    .lang-toggle { font-size:0.75rem; font-weight:600; padding:0.25rem 0.6rem; border-radius:4px; border:1.5px solid rgba(255,255,255,0.4); color:#fff; background:transparent; cursor:pointer; transition:0.2s; }
    .lang-toggle:hover { background:rgba(255,255,255,0.15); }
  </style>
</head>
<body data-event-id="<%= event.id %>" data-contributor-id="<%= contributor.id %>">
  <nav>
    <div class="nav-container">
      <div class="nav-brand"><%= __('brand') %></div>
      <div class="nav-links">
        <a href="/admin/dashboard"><%= __('dashboard') %></a>
        <a href="/admin/events/<%= event.id %>"><%= __('eventDetail') %></a>
        <a href="/admin/debtors"><%= __('debtors') %></a>
        <a href="/admin/activity-log"><%= __('activityLog') %></a>
        <a href="#" data-action="toggleNotifications" class="notif-bell" style="position:relative;">
          <i class="fas fa-bell"></i>
          <span id="notifBadge" class="notif-badge" style="<%= unreadCount > 0 ? '' : 'display:none;' %>"><%= unreadCount %></span>
        </a>
        <a href="#" data-action="toggleLang" class="lang-toggle"><%= lang === 'sw' ? 'EN' : 'SW' %></a>
        <a href="/admin/change-password"><%= __('changePassword') %></a>
        <a href="/admin/logout"><%= __('logout') %></a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <a href="/admin/events/<%= event.id %>" class="back-link">&larr; <%= __('backToEvent') %></a>
    </div>

    <div class="event-card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;">
        <div>
          <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
            <h1 style="margin:0;"><%= contributor.full_name %></h1>
            <button data-action="showEditContributor" class="btn btn-sm btn-secondary" style="font-size:0.75rem;"><i class="fas fa-pen"></i> Edit</button>
          </div>
          <p style="color:#888;font-size:0.9rem;margin-top:0.25rem;">
            <span class="contributor-id-badge"><%= contributor.contributor_id %></span>
            <span style="margin-left:0.5rem;"><%= contributor.contribution_type %></span>
          </p>
        </div>
        <span class="badge <%= contributor.status === 'Done' ? 'badge-success' : 'badge-warning' %>" style="font-size:0.9rem;padding:0.4rem 1rem;">
          <%= contributor.status %>
        </span>
      </div>

      <div class="stats-grid" style="margin-top:1.5rem;">
        <div class="stat-card">
          <div class="stat-value">TZS <%= Number(contributor.promise_amount || 0).toLocaleString() %></div>
          <div class="stat-label"><%= __('promised') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-value">TZS <%= Number(contributor.paid_amount || 0).toLocaleString() %></div>
          <div class="stat-label"><%= __('paid') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-value">TZS <%= Number(contributor.remaining_balance || 0).toLocaleString() %></div>
          <div class="stat-label"><%= __('remaining') %></div>
        </div>
      </div>

      <div class="detail-info">
        <p><span class="label"><%= __('phoneColon') %></span> <%= contributor.phone_number || '-' %></p>
        <p><span class="label"><%= __('paymentMethodColon') %></span> <%= contributor.payment_method || '-' %></p>
        <p><span class="label"><%= __('senderColon') %></span> <%= contributor.sender_name || '-' %></p>
        <p><span class="label"><%= __('dateColon') %></span> <%= new Date(contributor.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      </div>

      <div class="notes-section" style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid #f0f0f0;">
        <label for="notes" style="display:block;font-size:0.85rem;font-weight:500;color:#555;margin-bottom:0.35rem;"><%= __('adminNotes') %></label>
        <textarea id="notes" rows="3" style="width:100%;padding:0.7rem 0.85rem;font-size:0.9rem;border:1.5px solid #e0e0e0;border-radius:6px;font-family:'Inter',sans-serif;resize:vertical;"><%= contributor.notes || '' %></textarea>
        <button data-action="saveNotes" class="btn btn-sm btn-primary" style="margin-top:0.5rem;"><i class="fas fa-save"></i> <%= __('saveNotes') %></button>
        <span id="notesStatus" style="margin-left:0.5rem;font-size:0.85rem;color:#2e7d32;display:none;"><%= __('saved') %></span>
      </div>
    </div>

    <div id="editContributorModal" class="modal-overlay" style="display:none;">
      <div class="modal-content form-card" style="max-width:500px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
          <h3 style="margin:0;"><%= __('edit') %> Contributor</h3>
          <button data-action="closeEditContributor" style="background:none;border:none;font-size:1.2rem;cursor:pointer;color:#888;">&times;</button>
        </div>
        <form id="editContributorForm">
          <div class="form-group">
            <label><%= __('fullName') %> *</label>
            <input type="text" id="edit_con_name" value="<%= contributor.full_name %>" required>
          </div>
          <div class="form-group">
            <label><%= __('phoneNumber') %></label>
            <input type="text" id="edit_con_phone" value="<%= contributor.phone_number||'' %>">
          </div>
          <div class="form-group" id="edit_promise_group" <%= contributor.contribution_type === 'Cash' ? 'style="display:none;"' : '' %>>
            <label><%= __('promiseAmount') %> (TZS)</label>
            <input type="number" id="edit_con_promise" value="<%= contributor.promise_amount || 0 %>" min="0" step="1">
          </div>
          <div class="form-group" id="edit_paid_group">
            <label><%= __('amountPaid') %> (TZS)</label>
            <input type="number" id="edit_con_paid" value="<%= contributor.paid_amount || 0 %>" min="0" step="1">
          </div>
          <div style="display:flex;gap:0.5rem;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= __('save') %></button>
            <button type="button" data-action="closeEditContributor" class="btn btn-sm btn-secondary"><%= __('cancel') %></button>
            <span id="editConStatus"></span>
          </div>
        </form>
      </div>
    </div>

    <div class="section">
      <div class="section-header">
        <h2><%= __('paymentHistory') %></h2>
      </div>

      <% if (payments.length === 0) { %>
        <div class="empty-state">
          <p><%= __('noPayments') %></p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>#</th>
                <th><%= __('amount') %> (TZS)</th>
                <th><%= __('paymentMethod') %></th>
                <th><%= __('senderName') %></th>
                <th><%= __('date') %></th>
              </tr>
            </thead>
            <tbody>
              <% payments.forEach(function(p, idx) { %>
                <tr>
                  <td data-label="#">#<%= idx + 1 %></td>
                  <td data-label="<%= __('amount') %> (TZS)"><%= Number(p.amount).toLocaleString() %></td>
                  <td data-label="<%= __('paymentMethod') %>"><%= p.payment_method || '-' %></td>
                  <td data-label="<%= __('senderName') %>"><%= p.sender_name || '-' %></td>
                  <td data-label="<%= __('date') %>"><%= new Date(p.paid_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div id="notifPanel" class="notif-panel">
    <div class="notif-panel-header">
      <h3><%= __('notifications') %></h3>
      <button data-action="markAllRead" class="btn btn-sm" style="background:none;color:#1a237e;font-size:0.75rem;padding:0;"><i class="fas fa-check-double"></i> <%= __('markAllRead') %></button>
    </div>
    <div id="notifList" class="notif-list"><p style="text-align:center;color:#888;padding:1rem;font-size:0.85rem;"><%= __('loading') %></p></div>
  </div>
  <div id="notifOverlay" class="notif-overlay" data-action="closeNotifications"></div>

  <meta name="page-data" content="<%= JSON.stringify({ saved: __('saved'), saveFailed: __('saveFailed'), failed: __('failed'), loading: __('loading'), noNotifications: __('noNotifications'), failedToLoad: __('failedToLoad'), notifications: __('notifications'), edit: __('edit'), promiseAmount: __('promiseAmount'), amountPaid: __('amountPaid') }).replace(/'/g, '&#39;') %>">
  <script src="/js/app.js"></script>
  <script src="/js/contributor-detail.js"></script>
  <script src="/js/csrf.js"></script>
  <script src="/js/notifications.js"></script>
</body>
</html>