<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('debtors') %> - <%= __('brand') %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1a237e">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/icons/icon-180.png">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&family=Montserrat:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    .lang-toggle { font-size:0.75rem; font-weight:600; padding:0.25rem 0.6rem; border-radius:4px; border:1.5px solid rgba(255,255,255,0.4); color:#fff; background:transparent; cursor:pointer; transition:0.2s; }
    .lang-toggle:hover { background:rgba(255,255,255,0.15); }
    .event-section { margin-bottom: 2rem; }
    .event-section h3 { font-size:1rem; color:#1a237e; margin-bottom:0.5rem; border-bottom:2px solid #e0e0e0; padding-bottom:0.4rem; }
    .event-section .event-total { font-size:0.8rem; color:#888; margin-bottom:0.8rem; }
  </style>
</head>
<body>
  <nav>
    <div class="nav-container">
      <div class="nav-brand"><%= __('brand') %></div>
      <div class="nav-links">
        <a href="/admin/dashboard"><%= __('dashboard') %></a>
        <a href="/admin/events/create"><%= __('createEvent') %></a>
        <a href="/admin/debtors" class="active"><%= __('debtors') %></a>
        <a href="/admin/activity-log"><%= __('activityLog') %></a>
        <a href="#" data-action="toggleNotifications" class="notif-bell" style="position:relative;">
          <i class="fas fa-bell"></i>
          <span id="notifBadge" class="notif-badge" style="<%= unreadCount > 0 ? '' : 'display:none;' %>"><%= unreadCount %></span>
        </a>
        <a href="#" data-action="toggleLang" class="lang-toggle"><%= lang === 'sw' ? 'EN' : 'SW' %></a>
        <a href="/admin/change-password"><%= __('changePassword') %></a>
        <a href="/admin/logout"><%= __('logout') %></a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h1><%= __('debtorsList') %></h1>
      <p style="color:#888;font-size:0.85rem;"><%= __('debtorsSubtext') %></p>
    </div>

    <% var allKeys = Object.keys(grouped); %>
    <% var totalOutstanding = 0; allKeys.forEach(function(k) { grouped[k].forEach(function(d) { totalOutstanding += Number(d.remaining_balance||0); }); }); %>

    <div class="stats-grid" style="margin-bottom:1.5rem;">
      <div class="stat-card">
        <div class="stat-value"><%= allKeys.length %></div>
        <div class="stat-label"><%= __('eventsWithDebtors') %></div>
      </div>
      <div class="stat-card">
        <div class="stat-value">TZS <%= Number(totalOutstanding).toLocaleString() %></div>
        <div class="stat-label"><%= __('totalOutstanding') %></div>
      </div>
    </div>

    <% if (allKeys.length === 0) { %>
      <div class="empty-state"><p><%= __('noDebtors') %></p></div>
    <% } else { %>
      <% allKeys.forEach(function(eventName) { %>
        <% var evDebtors = grouped[eventName]; %>
        <% var evTotal = evDebtors.reduce(function(s,c){ return s + Number(c.remaining_balance||0); }, 0); %>
        <div class="event-section">
          <h3><%= eventName %></h3>
          <div class="event-total"><%= evDebtors.length %> <%= __('debtorCount').split('{count}')[0] || '' %> — TZS <%= Number(evTotal).toLocaleString() %> <%= __('totalOutstanding').toLowerCase() %></div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th><%= __('id') %></th>
                  <th><%= __('fullName') %></th>
                  <th><%= __('phone') %></th>
                  <th><%= __('promised') %> (TZS)</th>
                  <th><%= __('paid') %> (TZS)</th>
                  <th><%= __('remaining') %> (TZS)</th>
                  <th><%= __('action') %></th>
                </tr>
              </thead>
              <tbody>
                <% evDebtors.forEach(function(d) { %>
                  <tr>
                    <td data-label="<%= __('id') %>"><span class="contributor-id-badge"><%= d.contributor_id || '-' %></span></td>
                    <td data-label="<%= __('fullName') %>"><strong><%= d.full_name %></strong></td>
                    <td data-label="<%= __('phone') %>">
                      <% if (d.phone_number) { %>
                        <a href="tel:<%= d.phone_number %>" style="color:#1a237e;"><i class="fas fa-phone"></i> <%= d.phone_number %></a>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td data-label="<%= __('promised') %> (TZS)"><%= Number(d.promise_amount).toLocaleString() %></td>
                    <td data-label="<%= __('paid') %> (TZS)"><%= Number(d.paid_amount).toLocaleString() %></td>
                    <td data-label="<%= __('remaining') %> (TZS)"><strong style="color:#c62828;"><%= Number(d.remaining_balance).toLocaleString() %></strong></td>
                    <td data-label="<%= __('action') %>"><a href="/admin/events/<%= d.event_id %>/contributors/<%= d.id %>" class="btn btn-sm btn-secondary"><i class="fas fa-eye"></i> <%= __('view') %></a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div id="notifPanel" class="notif-panel">
    <div class="notif-panel-header">
      <h3><%= __('notifications') %></h3>
      <button data-action="markAllRead" class="btn btn-sm" style="background:none;color:#1a237e;font-size:0.75rem;padding:0;"><i class="fas fa-check-double"></i> <%= __('markAllRead') %></button>
    </div>
    <div id="notifList" class="notif-list"><p style="text-align:center;color:#888;padding:1rem;font-size:0.85rem;"><%= __('loading') %></p></div>
  </div>
  <div id="notifOverlay" class="notif-overlay" data-action="closeNotifications"></div>

  <meta name="page-data" content="<%= JSON.stringify({ loading: __('loading'), noNotifications: __('noNotifications'), failedToLoad: __('failedToLoad'), notifications: __('notifications') }).replace(/'/g, '&#39;') %>">
  <script src="/js/app.js"></script>
  <script src="/js/csrf.js"></script>
  <script src="/js/notifications.js"></script>
</body>
</html>
