<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('brand') %> - <%= __('createEvent') %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1a237e">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/icons/icon-180.png">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&family=Montserrat:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    .lang-toggle { font-size:0.75rem; font-weight:600; padding:0.25rem 0.6rem; border-radius:4px; border:1.5px solid rgba(255,255,255,0.4); color:#fff; background:transparent; cursor:pointer; transition:0.2s; }
    .lang-toggle:hover { background:rgba(255,255,255,0.15); }
  </style>
</head>
<body>
  <nav>
    <div class="nav-container">
      <div class="nav-brand"><%= __('brand') %></div>
      <div class="nav-links">
        <a href="/admin/dashboard"><%= __('dashboard') %></a>
        <a href="/admin/events/create" class="active"><%= __('createEvent') %></a>
        <a href="/admin/debtors"><%= __('debtors') %></a>
        <a href="/admin/activity-log"><%= __('activityLog') %></a>
        <a href="#" data-action="toggleNotifications" class="notif-bell" style="position:relative;">
          <i class="fas fa-bell"></i>
          <span id="notifBadge" class="notif-badge" style="<%= unreadCount > 0 ? '' : 'display:none;' %>"><%= unreadCount %></span>
        </a>
        <a href="#" data-action="toggleLang" class="lang-toggle"><%= lang === 'sw' ? 'EN' : 'SW' %></a>
        <a href="/admin/change-password"><%= __('changePassword') %></a>
        <a href="/admin/logout"><%= __('logout') %></a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="form-card">
      <h1><%= __('createEvent') %></h1>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/events/create">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="name"><%= __('eventNameLabel') %></label>
          <input type="text" id="name" name="name" required placeholder="<%= __('eventNamePlaceholder') %>" value="<%= form ? form.name : '' %>">
        </div>

        <div class="form-group">
          <label for="event_type"><%= __('eventType') %></label>
          <select id="event_type" name="event_type" data-action="toggleEventType">
            <option value="Wedding" <%= form && form.event_type === 'Wedding' ? 'selected' : '' %>><%= __('wedding') %></option>
            <option value="Birthday" <%= form && form.event_type === 'Birthday' ? 'selected' : '' %>><%= __('birthday') %></option>
            <option value="Graduation" <%= form && form.event_type === 'Graduation' ? 'selected' : '' %>><%= __('graduation') %></option>
            <option value="Anniversary" <%= form && form.event_type === 'Anniversary' ? 'selected' : '' %>><%= __('anniversary') %></option>
            <option value="Fundraiser" <%= form && form.event_type === 'Fundraiser' ? 'selected' : '' %>><%= __('fundraiser') %></option>
            <option value="Memorial" <%= form && form.event_type === 'Memorial' ? 'selected' : '' %>><%= __('memorial') %></option>
            <option value="Other" <%= form && (form.event_type === 'Other' || (form.event_type && !['Wedding','Birthday','Graduation','Anniversary','Fundraiser','Memorial'].includes(form.event_type))) ? 'selected' : '' %>><%= __('other') %></option>
          </select>
        </div>

        <div class="form-group" id="customTypeField" style="display:none;">
          <label for="custom_type"><%= __('customEventType') %></label>
          <input type="text" id="custom_type" name="custom_type" placeholder="<%= __('customTypePlaceholder') %>" value="<%= form && form.custom_type ? form.custom_type : '' %>">
        </div>

        <div id="weddingFields">
          <div class="form-row">
            <div class="form-group">
              <label for="groom_name"><%= __('groomName') %></label>
              <input type="text" id="groom_name" name="groom_name" placeholder="<%= __('groomPlaceholder') %>" value="<%= form ? form.groom_name : '' %>">
            </div>
            <div class="form-group">
              <label for="bride_name"><%= __('brideName') %></label>
              <input type="text" id="bride_name" name="bride_name" placeholder="<%= __('bridePlaceholder') %>" value="<%= form ? form.bride_name : '' %>">
            </div>
          </div>
        </div>

        <div id="personFields">
          <div class="form-row" id="personRow">
            <div class="form-group">
              <label id="person1Label"><%= __('person1') %></label>
              <input type="text" id="person1_name" name="person1_name" placeholder="<%= __('person1Placeholder') %>" value="<%= form ? form.person1_name : '' %>">
            </div>
            <div class="form-group" id="person2Group">
              <label><%= __('person2') %></label>
              <input type="text" id="person2_name" name="person2_name" placeholder="<%= __('person2Placeholder') %>" value="<%= form ? form.person2_name : '' %>">
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="event_date"><%= __('eventDate') %></label>
            <input type="date" id="event_date" name="event_date" value="<%= form ? form.event_date : '' %>">
          </div>
          <div class="form-group">
            <label for="venue"><%= __('venue') %></label>
            <input type="text" id="venue" name="venue" placeholder="<%= __('venuePlaceholder') %>" value="<%= form ? form.venue : '' %>">
          </div>
        </div>

        <div class="form-group">
          <label for="target_amount"><%= __('targetAmount') %></label>
          <input type="number" id="target_amount" name="target_amount" min="0" step="1" placeholder="<%= __('targetAmountPlaceholder') %>" value="<%= form ? form.target_amount : '' %>">
          <p style="font-size:0.75rem;color:#888;margin-top:0.25rem;"><%= __('targetAmountHint') %></p>
        </div>

        <button type="submit" class="btn btn-primary btn-full"><%= __('createEvent') %></button>
      </form>
    </div>
  </div>

  <meta name="page-data" content="<%= JSON.stringify({ person1: __('person1'), personName: __('personName'), loading: __('loading'), noNotifications: __('noNotifications'), failedToLoad: __('failedToLoad'), notifications: __('notifications') }).replace(/'/g, '&#39;') %>">
  <script src="/js/app.js"></script>
  <script src="/js/create-event.js"></script>
  <script src="/js/csrf.js"></script>

  <div id="notifPanel" class="notif-panel">
    <div class="notif-panel-header">
      <h3><%= __('notifications') %></h3>
      <button data-action="markAllRead" class="btn btn-sm" style="background:none;color:#1a237e;font-size:0.75rem;padding:0;"><i class="fas fa-check-double"></i> <%= __('markAllRead') %></button>
    </div>
    <div id="notifList" class="notif-list"><p style="text-align:center;color:#888;padding:1rem;font-size:0.85rem;"><%= __('loading') %></p></div>
  </div>
  <div id="notifOverlay" class="notif-overlay" data-action="closeNotifications"></div>

  <script src="/js/notifications.js"></script>
</body>
</html>
